<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.0 General Task//EN" "generalTask.dtd">
<task id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4">
  <title>Ensuring the reason for separation (RFS) details are correct</title>
  <prolog>
    <source href="https://ort-orl.esdc-edsc.canada.ca/en/procedure/task/completing_roe_strike_lockout.shtml" scope="external" format="html"/>
  </prolog>
  <taskbody>
    <steps>
      <step id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_st1">
        <cmd id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_cmd1">In NWS, determine if there is a ROD on file for the period of employment:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_ul1">
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li1">If yes, go to step 8.</li>
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li2">If no, go to step 10.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_st2">
        <cmd id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_cmd2">Determine if the ROD indicates that the RFS is other than labour dispute, strike or lockout:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_ul2">
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li3">If yes, go to step 9.</li>
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li4">If no, go to step 10.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_st3">
        <cmd id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_cmd3">In NWS, on the Resolve Issue tab of the ROE RFS Action WI, complete the Resolve Issue section as follows:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_ul3">
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li5">Do the Reason for Separation details need to be modified?: Select Yes and the applicable RFS changes required (as indicated in the ROD).</li>
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li6">Go to step 11.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_st4">
        <cmd id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_cmd4">In NWS, on the Resolve Issue tab of the ROE RFS Action WI, complete the Resolve Issue section as follows:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_ul4">
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li7">Do the Reason for Separation details need to be modified?: Select No .</li>
            <li id="completing_roe_strike_lockout_ensuring_the_reason_for_separation_rfs__eb340be4_li8">Go to step 16.</li>
          </ul>
        </info>
      </step>
    </steps>
  </taskbody>
</task>