<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA 2.0 General Task//EN" "generalTask.dtd">
<task id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e">
  <title>Selecting a special condition for the decision on file</title>
  <prolog>
    <source href="https://ort-orl.esdc-edsc.canada.ca/en/procedure/task/completing_roe_strike_lockout.shtml" scope="external" format="html"/>
  </prolog>
  <taskbody>
    <steps>
      <step id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_st1">
        <cmd id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_cmd1">Determine which special condition options are displayed:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_ul1">
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li1">If multiple options are displayed, go to step 12.</li>
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li2">If No Decision Matches the ROE is the only option displayed, go to step 14.</li>
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li3">If no special condition options are displayed, go to step 16.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_st2">
        <cmd id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_cmd2">Review the decision indicated in the ROD:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_ul2">
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li4">If the ROD indicates that adjudication was deferred, go to step 13.</li>
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li5">If the ROD does not indicate that adjudication was deferred, go to step 15.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_st3">
        <cmd id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_cmd3">In NWS, on the Resolve Issue tab of the ROE RFS Action WI, complete the Resolve Issue section as follows:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_ul3">
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li6">Select the Special Condition for the decision on file: Select Adjudication Deferred .</li>
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li7">Go to step 16.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_st4">
        <cmd id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_cmd4">In NWS, on the Resolve Issue tab of the ROE RFS Action WI, complete the Resolve Issue section as follows:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_ul4">
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li8">Select the Special Condition for the decision on file: Select No Decision Matches the ROE .</li>
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li9">Go to step 16.</li>
          </ul>
        </info>
      </step>
      <step id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_st5">
        <cmd id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_cmd5">In NWS, on the Resolve Issue tab of the ROE RFS Action WI, complete the Resolve Issue section as follows:</cmd>
        <info>
          <ul id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_ul5">
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li10">
              Select the Special Condition for the decision on file: Select the option that matches the decision in the ROD:
              <ul id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_ul6">
                <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li11">If the decision indicates Suspension from employment (D-42) , select Suspension .</li>
                <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li12">If the decision indicates Anticipated Loss of Employment (D-44) , select Anticipated Loss of Employment and enter the disentitlement dates from the decision.</li>
              </ul>
            </li>
            <li id="completing_roe_strike_lockout_selecting_a_special_condition_for_the_d_abfa0b7e_li13">Go to step 16.</li>
          </ul>
        </info>
      </step>
    </steps>
  </taskbody>
</task>